# Traces are compared byte-for-byte (replay's exit check) and checksummed as
# evidence. With core.autocrlf=true, git would check them out with CRLF line
# endings and silently change every byte-level comparison. Never convert them.
*.jsonl -text
docs/evidence/** -text

# Regression-event slices are model input: their bytes feed prompt hashes.
data/events/** -text

# Recorded traces, their labels and manifest are evidence read back by hash and
# compared as written; keep them exactly as recorded.
data/traces/** -text
